---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={`Blog · ${site.name}`} description="Artículos de psicología cristiana y consejería bíblica en español: ansiedad, depresión, matrimonio, adicciones y vida cristiana.">
  <section class="section">
    <div class="container stack">
      <p class="eyebrow">Blog</p>
      <h1 style="font-size: var(--fs-h2);">Artículos</h1>
      <div class="post-list">
        {posts.map((p) => (
          <article class="card interactive">
            <p class="meta">{fmt(p.data.pubDate)}</p>
            <h2 style="font-size: var(--fs-h3); margin-top: 8px;"><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
            <p style="color: var(--muted); margin-top: 8px;">{p.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
